[5.062692, "o", "usage: token-finops sessions [-h] [--since {1d,7d,30d,all}] [--session SESSION] [--limit LIMIT]\r\n                             [--gap-minutes GAP_MINUTES] [--totals] [--db-path DB_PATH]\r\n\r\noptional arguments:\r\n  -h, --help            show this help message and exit\r\n  --since {1d,7d,30d,all}\r\n  --session SESSION     Show a detailed break/gap report for this one session_id instead of the list\r\n  --limit LIMIT         Max number of sessions to list (default 20, ignored with --session/--totals)\r\n  --gap-minutes GAP_MINUTES\r\n                        Idle gap threshold in minutes to count as a 'break' in the detailed\r\n                        --session/--totals views (default 30)\r\n  --totals              Print one combined report aggregated across ALL sessions matching --since (requests,\r\n                        tokens, AI units, and combined active/idle/break totals), instead of a per-session\r\n                        list.\r\n  --db-path DB_PATH     Path to the session-store.db to read (default: $TOKEN_FINOPS_DB or\r\n "]
