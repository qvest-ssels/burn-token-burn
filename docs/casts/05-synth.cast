[0.012459, "o", "\u001b[1;32m$ \u001b[0mtoken-finops synth --out ~/demo-home --scenario exhausted --print-env\r\n"]
[0.087396, "o", "Synthetic data written under ~/demo-home (scenario=exhausted):\r\n  copilot      events=112    ~/demo-home/.copilot/session-store.db\r\n    - session-store.db, table assistant_usage_events\r\n  claude_code  events=84     ~/demo-home/.claude/projects\r\n    - main loop calls: 60, sub-agent calls: 24\r\n    - quota snapshot written: True\r\n  codex        events=110    ~/demo-home/.codex/sessions\r\n    - rollout-*.jsonl with token_count deltas + rate_limits.primary/secondary\r\n  gemini_cli   events=86     ~/demo-home/.gemini/tmp\r\n    - chats/*.jsonl + projects.json\r\n  hermes       events=14     ~/demo-home/.hermes/state.db\r\n    - sessions + session_model_usage\r\n  opencode     events=7      ~/demo-home/.local/share/opencode/opencode.db\r\n    - session + session_message\r\n  cline        events=12     ~/demo-home/.config/Code/User/globalStorage\r\n    - saoudrizwan.claude-dev + rooveterinaryinc.roo-cline + kilocode.kilo-code tasks\r\n  aider        events=3      ~/demo-home/.aider.chat.history.md\r\n    - chat-history markdown + .aider/analytics.jsonl\r\n  continue     events=2      ~/demo-home/.continue/sessions\r\n    - sessions.json + <uuid>.json\r\n\r\nexport HOME=~/demo-home\r\nexport USERPROFILE=~/demo-home\r\nexport TOKEN_FINOPS_COPILOT_DB=~/demo-home/.copilot/session-store.db\r\nexport CLAUDE_CONFIG_DIR=~/demo-home/.claude\r\nexport CODEX_HOME=~/demo-home/.codex\r\nexport GEMINI_CLI_HOME=~/demo-home/.gemini\r\nexport HERMES_HOME=~/demo-home/.hermes\r\nexport XDG_DATA_HOME=~/demo-home/.local/share\r\nexport TOKEN_FINOPS_OPENCODE_DB=~/demo-home/.local/share/opencode/opencode.db\r\nexport TOKEN_FINOPS_CLINE_DIRS=~/demo-home/.config/Code/User/globalStorage\r\nexport CONTINUE_GLOBAL_DIR=~/demo-home/.continue\r\nexport TOKEN_FINOPS_AIDER_DIRS=~/demo-home\r\n"]
[0.092458, "o", "\r\n"]
