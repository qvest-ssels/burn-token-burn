[0.017096, "o", "\u001b[1;32m$ \u001b[0mtoken-finops synth --out /tmp/demo-home --scenario exhausted --print-env\r\n"]
[0.703993, "o", "Synthetic data written under /tmp/demo-home (scenario=exhausted):\r\n  copilot      events=112    /tmp/demo-home/.copilot/session-store.db\r\n    - session-store.db, table assistant_usage_events\r\n  claude_code  events=84     /tmp/demo-home/.claude/projects\r\n    - main loop calls: 60, sub-agent calls: 24\r\n    - quota snapshot written: True\r\n  codex        events=110    /tmp/demo-home/.codex/sessions\r\n    - rollout-*.jsonl with token_count deltas + rate_limits.primary/secondary\r\n  gemini_cli   events=86     /tmp/demo-home/.gemini/tmp\r\n    - chats/*.jsonl + projects.json\r\n  hermes       events=14     /tmp/demo-home/.hermes/state.db\r\n    - sessions + session_model_usage\r\n  opencode     events=7      /tmp/demo-home/.local/share/opencode/opencode.db\r\n    - session + session_message\r\n  cline        events=12     /tmp/demo-home/.config/Code/User/globalStorage\r\n    - saoudrizwan.claude-dev + rooveterinaryinc.roo-cline + kilocode.kilo-code tasks\r\n  aider        events=3      /tmp/demo-home/.aider.chat.history.md\r\n    - chat-history markdown + .aider/analytics.jsonl\r\n  continue     events=2      /tmp/demo-home/.continue/sessions\r\n    - sessions.json + <uuid>.json\r\n\r\nexport HOME=/tmp/demo-home\r\nexport USERPROFILE=/tmp/demo-home\r\nexport TOKEN_FINOPS_COPILOT_DB=/tmp/demo-home/.copilot/session-store.db\r\nexport CLAUDE_CONFIG_DIR=/tmp/demo-home/.claude\r\nexport CODEX_HOME=/tmp/demo-home/.codex\r\nexport GEMINI_CLI_HOME=/tmp/demo-home/.gemini\r\nexport HERMES_HOME=/tmp/demo-home/.hermes\r\nexport XDG_DATA_HOME=/tmp/demo-home/.local/share\r\nexport TOKEN_FINOPS_OPENCODE_DB=/tmp/demo-home/.local/share/opencode/opencode.db\r\nexport TOKEN_FINOPS_CLINE_DIRS=/tmp/demo-home/.config/Code/User/globalStorage\r\nexport CONTINUE_GLOBAL_DIR=/tmp/demo-home/.continue\r\nexport TOKEN_FINOPS_AIDER_DIRS=/tmp/demo-home\r\n"]
[0.715097, "o", "\r\n"]
